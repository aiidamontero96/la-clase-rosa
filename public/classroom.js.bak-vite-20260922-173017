  function alphabet(){return '<details class="panel alphabet-panel"'+(alphabetOpen?' open':'')+'><summary class="alphabet-summary"><span><strong>Abecedario</strong><small>Elige letras con contorno para colorear y practicar el trazo.</small></span></summary><div class="alphabet-panel-body"><div class="heading-row alphabet-heading"><div><span class="eyebrow">ABECEDARIO PARA COLOREAR Y TRAZAR</span><h2>Elige las letras que necesitas</h2></div>'+btn('Seleccionar todas','alphabet-all','','secondary')+'</div><div class="alphabet-workspace"><div><div class="alphabet-grid">'+alphabetLetters.map((l,i)=>'<div><button class="letter-choice '+(letterPage===i+1?'active':'')+'" data-action="alphabet-preview" data-value="'+(i+1)+'" aria-label="Ver letra '+l+'">'+l+'</button><label><input type="checkbox" data-alphabet-page="'+(i+1)+'"'+(selectedLetters.has(i+1)?' checked':'')+'> Imprimir '+l+'</label></div>').join('')+'</div><p id="alphabet-count" role="status">'+selectedLetters.size+' letras seleccionadas</p>'+btn('Imprimir selección','alphabet-print')+' '+btn('Vaciar selección','alphabet-clear','','quiet')+'</div><figure><img id="alphabet-preview" src="'+alphabetSrc(letterPage)+'" alt="Cartel de la letra '+alphabetLetters[letterPage-1]+'"><figcaption>Versión limpia en contorno para colorear y repasar.</figcaption></figure></div></div></details>';}
  function printLetters(){if(!selectedLetters.size){toast('Elige al menos una letra.');return;}const w=window.open('','_blank');if(!w){toast('Permite la ventana de impresión y vuelve a intentarlo.');return;}w.document.write('<!doctype html><html lang="es"><head><meta charset="utf-8"><base href="'+esc(new URL('.',location.href).href)+'"><title>Mis letras</title><style>@page{size:A4;margin:0}body{margin:0}section{height:297mm;width:210mm;break-after:page;display:flex;align-items:center;justify-content:center}section:last-child{break-after:auto}img{max-width:100%;max-height:100%;object-fit:contain}nav{padding:15px}button{padding:12px;font-size:18px}@media print{nav{display:none}}</style></head><body><nav><button onclick="window.print()">Imprimir selección / Guardar PDF</button><button onclick="window.close()">Volver</button></nav>'+[...selectedLetters].sort((a,b)=>a-b).map(page=>'<section><img src="'+alphabetSrc(page)+'" alt="Cartelería del abecedario"></section>').join('')+'</body></html>');w.document.close();}
