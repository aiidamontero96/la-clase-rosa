  function handle(action,value){
    if(action==='pdi-jump'){document.getElementById(value)?.scrollIntoView({behavior:'smooth',block:'start'});return true;}
    if(action==='theme-game'||action==='selected-theme'){const [kind,t]=value.split('|');const theme=t||document.querySelector('#classroom-theme')?.value||'Océano';void A.launch(kind,{round:0,payload:{theme}});return true;}
    if(action==='dino-project-games'){state.dinoTab='juegos';location.hash='dinosaurios';render();return true;}
    if(action==='species-open'){startProjection('dino-ficha',Number(value));return true;}
    if(window.ROSA_SCENES?.handle(action,value))return true;
    if(action==='fact-reveal'){state.projection.payload={...(state.projection.payload||{}),fact:value};projectionRender();return true;}
    if(action==='expedition-open'){startProjection('expedicion',Math.max(0,Math.min(59,Number(value))));return true;}
    if(action==='expedition-route'){A.stopVoice();document.querySelector('#projector').close();state.dinoTab='ruta';location.hash='dinosaurios';render();return true;}
    if(action==='lesson-reveal'){document.querySelector('#lesson-reveal').textContent=value;return true;}
    if(action==='movement-open'){startProjection('movimiento-guiado',0,{session:Number(value)});return true;}
    if(action==='movement-step'){state.projection.round=Number(value);projectionRender();return true;}
    if(action==='movement-exit'){A.stopVoice();document.querySelector('#projector').close();location.hash='movimiento';render();return true;}
    if(action==='alphabet-preview'){alphabetOpen=true;letterPage=Number(value);render();return true;}
    if(action==='alphabet-all'){alphabetOpen=true;selectedLetters=new Set(alphabetLetters.map((_,i)=>i+2));render();return true;}
    if(action==='alphabet-clear'){alphabetOpen=true;selectedLetters.clear();render();return true;}
    if(action==='alphabet-print'){printLetters();return true;}
    if(action==='song-original'){startProjection('cancion',Number(value));return true;}
    if(action==='song-play'){A.stopVoice();const id=youtubeId(state.songLinks[Number(value)]);if(!id){toast('Esta canción no se puede reproducir.');return true;}state.projection=null;document.querySelector('#projection-content').innerHTML='<div class="projection-toolbar"><strong>'+esc(songTitles()[id]||'Canción de la clase')+'</strong>'+btn('CERRAR','close-projection')+'</div><div class="embedded-song"><iframe src="https://www.youtube-nocookie.com/embed/'+esc(id)+'?rel=0" title="Canción de la clase" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe></div>';document.querySelector('#projector').showModal();return true;}
    return false;
  }
