    else if(p.kind==='movimiento-guiado'){const m=movement[Number(p.payload?.session)||0],step=n%m[4].length;body='<span class="tag">'+m[0]+' · PASO '+(step+1)+' / '+m[4].length+'</span><div class="movement-symbol">'+m[1]+'</div><h2>'+m[4][step]+'</h2><p class="movement-note">'+m[5]+'</p>';foot=(step?btn('← ANTERIOR','movement-step',step-1,'secondary'):'')+(step<m[4].length-1?btn('SIGUIENTE CONSIGNA →','movement-step',step+1):btn('TERMINAR Y ELEGIR OTRA','movement-exit'));}
